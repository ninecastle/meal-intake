# web/.env.local로 복사해 쓴다(.env.local은 커밋하지 않는다).
# Gemini 모델 ID(스펙 5절). 비교 후보: gemini-3.8-flash
VITE_AI_MODEL=gemini-3.5-flash-lite
# 1이면 목업 응답(web/src/analysis/__fixtures__). 개발 기본 1, 배포 빌드 0
VITE_AI_MOCK=1
# 검색 그라운딩 단계 on|off. 기본값은 0단계 스파이크 결과로 정한다(스펙 U3)
VITE_SEARCH_GROUNDING=off
# on이면 개발 서버에서 Auth·Firestore 에뮬레이터 사용
VITE_USE_EMULATORS=on
