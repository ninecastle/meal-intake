rules_version = '2';

// 규칙 v2 (3단계 조각 1-2, 2026-10-26). 스펙 _workspace/01_architect_spec.md 2.1절(상태 전이)·3.2절(meals 필드).
// - 로그인한 본인만 users/{uid}/meals/* 를 읽고 쓴다.
// - 그 밖의 경로는 모두 거부한다.
// - 사진이 들어오지 않게 문서 키와 analysis·beforeAnalysis 하위 키를 허용 목록으로 제한한다.
// - 칼로리는 클라이언트가 쓰므로 형식·범위만 검사한다. 항목(items) 안의 필드는 검사하지 않는다(스펙 1.4절).
// - v2: 저장한 기록 수정(M16)으로 done → done 허용. 이때만 editedAt = request.time(v1은 done → done 거부).
// - v3(3단계 조각 2, 2026-10-27): 목표 설정 users/{uid}(goal 필드 하나)와 날짜별 목표 users/{uid}/goals/{dateKey}. 스펙 4.7절.
//   targets.target_kcal 하한은 스펙의 800이 아니라 300(리더 결정: 정상 최저값은 BMR 하한 약 390kcal).
// - v4(디자인 조각 D2-B, 2026-10-27): 하루 문서 users/{uid}/days/{dateKey}(공복 표시 fasted). 허용 필드는 dayFields() 한곳.
// - v5(디자인 조각 D3, 2026-10-27): 하루 문서에 끼니별 먹은 시간 mealTimes(선택, 끼니 키 → 24시간 "HH:MM").
// - v6(2026-10-27, 사용자가 고른 변경): 사용자 문서 users/{uid}에 설정 prefs.shareEaters("같이 먹은 사람 고르기", bool, 기본 꺼짐). goal·prefs 모두 선택 필드.
//   설정만 쓰는 병합은 기존 goal을 다시 검사하지 않는다(goalUntouched: 지난 goal.updatedAt이 request.time과 달라 막히는 것 방지).
// - v7(디자인 조각 D6, 2026-10-28): 체중 기록 users/{uid}/weights/{dateKey}(kg 30~250), 사용자 문서에 목표 몸무게 targetWeightKg(30~250),
//   설정 prefs.weightAskSkipKg("목표를 다시 계산할까요?"에서 [나중에]를 누른 때의 최근 체중, 30~250). 체중은 하루 문서가 아니라 따로 둔다
//   ("지난 기록" = 그 날짜 앞 가장 최근 체중을 dateKey 한 필드 범위·정렬로 찾게, 복합 인덱스 없이).
// - v8(디자인 조각 D9, 2026-10-28): 식사 사진 보관 users/{uid}/mealPhotos/{mealId}(스펙 4.12절, 선택·기본 꺼짐).
//   먹기 전·후 JPEG 썸네일 bytes(장당 100KB 이하)와 w·h(1~1000)만. 식사 기록(meals)과 분리, 본인만 읽기·쓰기·삭제.
//   설정 prefs.keepPhotos(bool, 없으면 아직 묻지 않음 = 꺼짐).
// - v9(디자인 조각 D10, 2026-10-28): 처음 동의 users/{uid}.consent { version(1~20자), agreedAt, required: true, photoKeep, school }(스펙 4.10절).
//   consent를 바꾸는 쓰기에서만 agreedAt == request.time. 목표·설정만 병합하면 저장된 consent는 다시 검사하지 않는다. consent 삭제는 거부.
// - v10(디자인 조각 D11, 2026-10-28): 설정 prefs.tutorialDone(bool, 첫 홈 튜토리얼을 다 봤거나 건너뜀. 없으면 아직 안 봄).
// - v11(2026-10-28 사용자 결정, 자동 공복): 하루 문서에 fastAuto(bool, 앱이 그날 자동 공복을 한 번 채웠음 — 사용자가 끈 공복을 다시 켜지 않게).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 호출 A 결과(BeforeAnalysis)
    function validBefore(b) {
      return b is map
        && b.keys().hasOnly(['items', 'warnings', 'model', 'prompt_version'])
        && b.items is list
        && b.items.size() <= 30;
    }

    // MealIntakeAnalysis v2 + consumedKcal 사본
    function validAnalysis(m) {
      return m.analysis is map
        && m.analysis.keys().hasOnly(['items', 'totals', 'warnings', 'model', 'prompt_version'])
        && m.analysis.items is list
        && m.analysis.items.size() <= 30
        && m.analysis.totals is map
        && m.analysis.totals.consumed is map
        && m.consumedKcal is number
        && m.consumedKcal >= 0
        && m.consumedKcal <= 10000
        && m.consumedKcal == m.analysis.totals.consumed.kcal;
    }

    function validMeal(m) {
      return m.keys().hasOnly(['dateKey', 'mealType', 'status', 'beforeAnalysis', 'analysis',
                               'consumedKcal', 'createdAt', 'updatedAt', 'editedAt'])
        && m.keys().hasAll(['dateKey', 'mealType', 'status', 'createdAt', 'updatedAt'])
        && m.dateKey is string
        && m.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && m.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && m.status in ['awaiting_after', 'needs_review', 'done']
        && m.createdAt is timestamp
        && m.updatedAt is timestamp
        && (!('editedAt' in m) || m.editedAt is timestamp)
        && (!('beforeAnalysis' in m) || validBefore(m.beforeAnalysis))
        && (('analysis' in m) == ('consumedKcal' in m))
        && (!('analysis' in m) || validAnalysis(m))
        // 상태별 필수 필드: awaiting_after는 먹기 전 분석, needs_review·done은 최종 분석
        && (m.status != 'awaiting_after' || ('beforeAnalysis' in m))
        && (m.status == 'awaiting_after' || ('analysis' in m));
    }

    // 2.1절: awaiting_after → needs_review·done, needs_review → done, done → done(저장한 기록 수정, M16).
    // done에서 다른 상태로 되돌리지 않는다. awaiting_after·needs_review는 같은 상태 유지도 없다.
    function validTransition(from, to) {
      return (from == 'awaiting_after' && to in ['needs_review', 'done'])
        || (from == 'needs_review' && to == 'done')
        || (from == 'done' && to == 'done');
    }

    // editedAt: done → done(수정)이면 이번 요청 시각. 그 밖의 전이에서는 기존 값 그대로(없으면 계속 없음).
    // validTransition이 done에서는 done → done만 허용하므로 이전 상태만 보면 된다.
    function validEditedAt(before, after) {
      return (before.status == 'done' && after.get('editedAt', null) == request.time)
        || (before.status != 'done' && after.get('editedAt', null) == before.get('editedAt', null));
    }

    match /users/{uid}/meals/{mealId} {
      allow read: if signedInAs(uid);

      // 없음 → awaiting_after(호출 A 성공), 없음 → done(직접 입력·샘플)
      allow create: if signedInAs(uid)
        && validMeal(request.resource.data)
        && request.resource.data.status in ['awaiting_after', 'done']
        && !('editedAt' in request.resource.data) // editedAt은 수정(done → done)에서만 생긴다
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInAs(uid)
        && validMeal(request.resource.data)
        && validTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.createdAt == resource.data.createdAt
        && validEditedAt(resource.data, request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedInAs(uid);
    }

    // ---- 목표 설정(스펙 4.7절) ----

    // GoalTargets: 키 정확히 5개, kcal 300~6000, 탄·단·지 0~1000g
    function validTargets(t) {
      return t is map
        && t.keys().hasOnly(['target_kcal', 'carbs_g', 'protein_g', 'fat_g', 'source'])
        && t.keys().hasAll(['target_kcal', 'carbs_g', 'protein_g', 'fat_g', 'source'])
        && t.target_kcal is number && t.target_kcal >= 300 && t.target_kcal <= 6000
        && t.carbs_g is number && t.carbs_g >= 0 && t.carbs_g <= 1000
        && t.protein_g is number && t.protein_g >= 0 && t.protein_g <= 1000
        && t.fat_g is number && t.fat_g >= 0 && t.fat_g <= 1000
        && t.source in ['recommended', 'custom'];
    }

    // GoalInput: 열거값·범위, 만 18세 미만은 유지만
    function validGoalInput(i) {
      return i is map
        && i.keys().hasOnly(['sex', 'age', 'height_cm', 'weight_kg', 'activity', 'goal'])
        && i.keys().hasAll(['sex', 'age', 'height_cm', 'weight_kg', 'activity', 'goal'])
        && i.sex in ['male', 'female']
        && i.age is int && i.age >= 14 && i.age <= 100
        && i.height_cm is number && i.height_cm >= 120 && i.height_cm <= 220
        && i.weight_kg is number && i.weight_kg >= 30 && i.weight_kg <= 250
        && i.activity in ['sedentary', 'light', 'moderate', 'active', 'very_active']
        && i.goal in ['lose', 'maintain', 'gain']
        && (i.age >= 18 || i.goal == 'maintain');
    }

    function validOverride(o) {
      return o == null
        || (o is map && o.keys().hasOnly(['target_kcal', 'carbs_g', 'protein_g', 'fat_g']));
    }

    function validGoal(g) {
      return g is map
        && g.keys().hasOnly(['input', 'override', 'result', 'targets', 'updatedAt'])
        && g.keys().hasAll(['input', 'override', 'result', 'targets', 'updatedAt'])
        && validGoalInput(g.input)
        && validOverride(g.override)
        && g.result is map
        && validTargets(g.targets)
        && g.updatedAt == request.time;
    }

    // 체중(v7): 목표 계산 입력(validGoalInput weight_kg)과 같은 범위
    function validKg(v) {
      return v is number && v >= 30 && v <= 250;
    }

    // 설정(v6): shareEaters(bool)·weightAskSkipKg(v7, kg)·keepPhotos(v8, bool)·tutorialDone(v10, bool) 모두 선택. 없으면 클라이언트가 꺼짐·없음으로 본다.
    function validPrefs(p) {
      return p is map
        && p.keys().hasOnly(['shareEaters', 'weightAskSkipKg', 'keepPhotos', 'tutorialDone'])
        && (!('shareEaters' in p) || p.shareEaters is bool)
        && (!('tutorialDone' in p) || p.tutorialDone is bool)
        && (!('keepPhotos' in p) || p.keepPhotos is bool)
        && (!('weightAskSkipKg' in p) || validKg(p.weightAskSkipKg));
    }

    // 프로필 문서: goal·prefs·targetWeightKg(v7) 중 일부(모두 선택). 삭제 규칙 없음(거부).
    // 설정을 목표보다 먼저 저장하면 prefs만 있는 문서가 된다.
    // 쓰기: 목표는 batch.set(userRef, {goal}, {mergeFields: ['goal']}), 설정은 setDoc(userRef, {prefs}, {merge: true}).
    // 둘 다 병합이라 병합 결과(request.resource.data) 전체를 검사한다.
    // 단, 이 쓰기가 goal을 건드리지 않으면(설정만 저장) 기존 goal은 다시 검사하지 않는다.
    // validGoal은 goal.updatedAt == request.time을 요구하므로, 저장된 goal은 다음 쓰기에서 통과할 수 없다.
    function goalUntouched() {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goal']);
    }

    // 처음 동의(v9): 다섯 키 모두, 필수 동의는 true만. agreedAt은 이번 요청 시각(serverTimestamp).
    // 쓰기는 saveConsent: setDoc(userRef, {consent, prefs: {keepPhotos}}, {merge: true}).
    function validConsent(c) {
      return c is map
        && c.keys().hasOnly(['version', 'agreedAt', 'required', 'photoKeep', 'school'])
        && c.keys().hasAll(['version', 'agreedAt', 'required', 'photoKeep', 'school'])
        && c.version is string && c.version.size() >= 1 && c.version.size() <= 20
        && c.required == true
        && c.photoKeep is bool
        && c.school is bool
        && c.agreedAt is timestamp
        && c.agreedAt == request.time;
    }

    // goalUntouched와 같은 이유: 저장된 consent.agreedAt은 다음 쓰기의 request.time과 다르다.
    function consentUntouched() {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent']);
    }

    // 있던 consent를 없애는 쓰기(deleteField 등) 거부
    function consentKept() {
      return resource == null
        || !('consent' in resource.data)
        || ('consent' in request.resource.data);
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['goal', 'prefs', 'targetWeightKg', 'consent'])
        && consentKept()
        && (!('consent' in request.resource.data) || consentUntouched() || validConsent(request.resource.data.consent))
        && (!('goal' in request.resource.data) || goalUntouched() || validGoal(request.resource.data.goal))
        && (!('prefs' in request.resource.data) || validPrefs(request.resource.data.prefs))
        && (!('targetWeightKg' in request.resource.data) || validKg(request.resource.data.targetWeightKg));
    }

    // 날짜별 목표: 문서 id == dateKey 필드. 같은 날은 덮어쓴다. 삭제 규칙 없음(거부).
    match /users/{uid}/goals/{dateKey} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['dateKey', 'targets', 'updatedAt'])
        && request.resource.data.keys().hasAll(['dateKey', 'targets', 'updatedAt'])
        && request.resource.data.dateKey == dateKey
        && validTargets(request.resource.data.targets)
        && request.resource.data.updatedAt == request.time;
    }

    // ---- 하루 문서(디자인 조각 D2-B, 2026-10-27): 끼니별 "공복했어요" 표시 ----
    // 쓰기는 setDoc(merge) + arrayUnion/arrayRemove + serverTimestamp라 create·update 둘 다 생긴다.
    // 병합 결과(request.resource.data) 전체를 검사한다.

    // 허용 필드는 이 목록 한곳에서 늘린다. 체중은 하루 문서가 아니라 users/{uid}/weights(v7).
    function dayFields() {
      return ['dateKey', 'fasted', 'mealTimes', 'fastAuto', 'updatedAt'];
    }

    // fasted: 끼니 열거값만, 중복 없이 4개 이하. 없을 수도 있다(체중만 쓰는 날 대비).
    function validFasted(f) {
      return f is list
        && f.size() <= 4
        && f.hasOnly(['breakfast', 'lunch', 'dinner', 'snack'])
        && f.toSet().size() == f.size();
    }

    // 24시간 "HH:MM"(00:00~23:59). matches는 문자열 전체 일치.
    function validHm(s) {
      return s is string && s.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }

    // mealTimes(v5): 끼니 키 일부만, 값은 모두 "HH:MM". 규칙은 map 값을 돌 수 없어 키마다 검사한다.
    // 쓰기는 setDoc(merge)라 기존 끼니 시각과 합쳐진 map 전체가 여기로 온다.
    function validMealTimes(t) {
      return t is map
        && t.keys().hasOnly(['breakfast', 'lunch', 'dinner', 'snack'])
        && (!('breakfast' in t) || validHm(t.breakfast))
        && (!('lunch' in t) || validHm(t.lunch))
        && (!('dinner' in t) || validHm(t.dinner))
        && (!('snack' in t) || validHm(t.snack));
    }

    function validDay(d, dateKey) {
      return d.keys().hasOnly(dayFields())
        && d.keys().hasAll(['dateKey', 'updatedAt'])
        && d.dateKey == dateKey
        && (!('fasted' in d) || validFasted(d.fasted))
        && (!('mealTimes' in d) || validMealTimes(d.mealTimes))
        && (!('fastAuto' in d) || d.fastAuto is bool)
        && d.updatedAt == request.time;
    }

    // 본인만 읽기·쓰기. 삭제는 본인 허용("내 기록 전체 삭제"용). 단일 문서 읽기라 인덱스 불필요.
    match /users/{uid}/days/{dateKey} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && validDay(request.resource.data, dateKey);
    }

    // ---- 체중 기록(v7, 디자인 조각 D6, 2026-10-28): 날짜마다 문서 하나, id == dateKey. 같은 날은 덮어쓴다 ----
    // 쓰기는 setDoc(덮어쓰기) { dateKey, kg, updatedAt: serverTimestamp() }. 지우기는 본인 허용(기록 지우기·내 기록 전체 삭제).
    // 조회 "지난 기록"·"최근 기록"은 dateKey 한 필드 범위 + 정렬 + limit(1)이라 단일 필드 인덱스로 동작한다.
    match /users/{uid}/weights/{dateKey} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['dateKey', 'kg', 'updatedAt'])
        && request.resource.data.keys().hasAll(['dateKey', 'kg', 'updatedAt'])
        && request.resource.data.dateKey == dateKey
        && validKg(request.resource.data.kg)
        && request.resource.data.updatedAt == request.time;
    }

    // ---- 식사 사진 보관(v8, 디자인 조각 D9, 스펙 4.12절): 기록마다 문서 하나, id == mealId ----
    // 쓰기는 setDoc(merge) 한 쪽씩 { before 또는 after: Bytes, w, h, updatedAt: serverTimestamp() }.
    // createdAt은 먹기 전 사진을 쓸 때만 넣는다(먹은 후 사진만 있는 기록은 없을 수 있다. 오프라인 대기열이라 문서 유무를 미리 읽지 않음).
    // 병합 결과 전체를 검사한다. 썸네일 한 장은 약 20~40KB라 100KB 상한은 여유가 있고, 문서 1MiB 한도도 넘지 않는다.
    function validThumb(b) {
      return b is bytes && b.size() > 0 && b.size() <= 100000;
    }

    function validPhotoSize(v) {
      return v is number && v >= 1 && v <= 1000;
    }

    function validMealPhotos(d) {
      return d.keys().hasOnly(['before', 'after', 'w', 'h', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['w', 'h', 'updatedAt'])
        && d.keys().hasAny(['before', 'after'])
        && (!('before' in d) || validThumb(d.before))
        && (!('after' in d) || validThumb(d.after))
        && validPhotoSize(d.w)
        && validPhotoSize(d.h)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && d.updatedAt == request.time;
    }

    match /users/{uid}/mealPhotos/{mealId} {
      allow read, delete: if signedInAs(uid);
      // 생성: createdAt이 있으면 이번 요청 시각. 수정: createdAt은 그대로이거나(먹은 후 사진) 이번 요청 시각(먹기 전 사진을 다시 씀).
      allow create: if signedInAs(uid)
        && validMealPhotos(request.resource.data)
        && request.resource.data.get('createdAt', request.time) == request.time;
      allow update: if signedInAs(uid)
        && validMealPhotos(request.resource.data)
        && (request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            || request.resource.data.get('createdAt', null) == request.time);
    }

    // 위에 없는 경로는 규칙이 없으므로 거부된다.
  }
}
